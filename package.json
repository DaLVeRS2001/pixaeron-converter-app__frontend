{
  "version": "1.0.0",
  "description": "Pixaeron image conversion web application",
  "name": "@pixaeron/web",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "webpack serve",
    "build:prod": "webpack --env mode=production",
    "build:dev": "webpack --env mode=development",
    "prepare": "husky",
    "app:fix": "concurrently \"npm run lint:scss:fix\" \"npm run lint:ts:fix\" \"npm run prettier\"",
    "test:unit": "jest --config  ./jest.config.ts --passWithNoTests",
    "prettier": "npx prettier . --write",
    "lint:ts": "npx eslint \"**/*.{ts,tsx,mjs,js}\"",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "lint:scss": "npx stylelint \"**/*.scss\"",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "schema:pull": "node scripts/sync-graphql-schema.mjs",
    "schema:check": "node scripts/sync-graphql-schema.mjs --check",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run codegen:check && npm run lint:ts && npm run lint:scss && npm run typecheck && npm run test:unit && npm run build:prod && npm run cloudflare:check",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "cloudflare:check": "node scripts/check-cloudflare-build.mjs",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "bem-cn": "^3.0.1",
    "graphql": "^16.14.2",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.0",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@types/webpack-dev-server": "^4.7.1",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.3",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.4",
    "react-refresh": "^0.18.0",
    "sass": "^1.101.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "wrangler": "4.114.0"
  }
}
