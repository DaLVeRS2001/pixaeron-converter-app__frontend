{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": "^[a-z]([a-z0-9-]+)?(__[a-z0-9-]+)?(_[a-z0-9-]+)?(--[a-z0-9-]+)?$",
    "unit-disallowed-list": ["px"],
    "block-no-empty": null,
    "no-empty-source": null,
    "length-zero-no-unit": true,
    "rule-empty-line-before": [
      "always",
      {
        "except": ["inside-block-and-after-rule"],
        "ignore": ["first-nested"]
      }
    ],
    "declaration-property-value-disallowed-list": {
      "/.*/": [
        "/--color-slate-/",
        "/--color-white/",
        "/--color-brand-[0-9]/",
        "/--color-(success|error|warning|info)-[0-9]/",
        "/#[0-9a-fA-F]{3,8}/",
        "/rgba?\\(/"
      ]
    }
  },
  "overrides": [
    {
      "files": ["src/app/styles/variables/global.scss"],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
