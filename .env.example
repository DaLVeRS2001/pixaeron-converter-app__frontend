PORT=3000

# Browser-facing GraphQL endpoint embedded by Webpack.
GRAPHQL_API_URL=/graphql

# Local development proxy target and direct backend schema endpoint.
AUTH_API_URL=http://127.0.0.1:3001
GRAPHQL_SCHEMA_URL=http://127.0.0.1:3001/auth

# Public browser keys. Neither value is a secret.
TURNSTILE_SITE_KEY=
GOOGLE_CLIENT_ID=
