PORT=3000

# Browser-facing GraphQL endpoint embedded by Webpack.
GRAPHQL_API_URL=/graphql

# Local development proxy target.
GATEWAY_API_URL=http://127.0.0.1:4000

# GraphOS graph and variant used only by schema synchronization.
# Authenticate Rover locally with `rover config auth`; never store APOLLO_KEY here.
APOLLO_GRAPH_REF=pixaeron@production

# Public browser keys. Neither value is a secret.
TURNSTILE_SITE_KEY=
GOOGLE_CLIENT_ID=
